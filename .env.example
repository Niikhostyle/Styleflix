# Copia a .env.local (local) y a Coolify → Environment Variables

# TMDB — https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# Vimeus
NEXT_PUBLIC_VIMEUS_VIEW_KEY=
VIMEUS_API_KEY=

# Auth (genera uno: openssl rand -base64 32)
AUTH_SECRET=

# URL pública (ej. https://veotv.cloud) — usada en back_url de MP
AUTH_URL=https://veotv.cloud

# PostgreSQL — obligatorio (Neon / Coolify Postgres)
# Local con Docker: postgresql://styleflix:styleflix@localhost:5432/styleflix
DATABASE_URL="postgresql://styleflix:styleflix@localhost:5432/styleflix"

# Mercado Pago — suscripción mensual VeoTV ($4.990 CLP)
# Credenciales TEST primero: https://www.mercadopago.cl/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: secreto de webhook (validación x-signature)
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional en UI; el checkout usa init_point del preapproval
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MEMBERSHIP_PRICE_CLP=4990
# Precio por cuenta para revendedores (admin crea PREPAID; días al 1er login)
RESELLER_PRICE_CLP=2990
# Webhook en panel MP → {AUTH_URL}/api/billing/webhook
