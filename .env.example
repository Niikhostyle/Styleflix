# Copia a .env.local (local) y a Coolify → Environment Variables

# TMDB — https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# Vimeus
NEXT_PUBLIC_VIMEUS_VIEW_KEY=
VIMEUS_API_KEY=

# Auth (genera uno: openssl rand -base64 32)
AUTH_SECRET=

# URL pública (ej. https://veotv.cloud) — usada en back_url de MP y enlaces de email
AUTH_URL=https://veotv.cloud

# Correo transaccional (confirmación + forgot password)
# Ej. Brevo / Gmail App Password / Mailgun / SMTP del hosting
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true si usas puerto 465
SMTP_SECURE=false
EMAIL_FROM="VeoTV <noreply@veotv.cloud>"
CONTACT_EMAIL=soporte@veotv.cloud
NEXT_PUBLIC_CONTACT_EMAIL=soporte@veotv.cloud

# PostgreSQL — obligatorio (Neon / Coolify Postgres)
# Local con Docker: postgresql://styleflix:styleflix@localhost:5432/styleflix
DATABASE_URL="postgresql://styleflix:styleflix@localhost:5432/styleflix"

# Mercado Pago — suscripción mensual VeoTV ($4.990 CLP)
# Producción: Public Key + Access Token de «Credenciales de producción»
# Ojo: el token es APP_USR-... (no APP_USER-)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_MODE=production
# Solo si pruebas en sandbox (NO en producción):
# MERCADOPAGO_MODE=test
# MERCADOPAGO_TEST_PAYER_USER=TESTUSER… del Comprador (nunca el Vendedor)
# MERCADOPAGO_TEST_PAYER_EMAIL=
# Opcional: secreto de webhook (validación x-signature)
MERCADOPAGO_WEBHOOK_SECRET=
# Obligatorio para Payment Brick (Build + Runtime en Coolify)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MEMBERSHIP_PRICE_CLP=4990
# Precio por cuenta para revendedores (admin crea PREPAID; días al 1er login)
RESELLER_PRICE_CLP=2990
# Webhook en panel MP → {AUTH_URL}/api/billing/webhook
