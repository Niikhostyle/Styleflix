{
  "name": "netflix-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/db-setup.cjs && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.cjs",
    "sources:check": "npx tsx scripts/check-sources.ts",
    "mangas:scrape": "npx tsx scripts/scrape-yupmanga.ts",
    "mangas:scrape:full": "npx tsx scripts/scrape-yupmanga.ts --with-chapters --limit=40",
    "mangas:download": "npx tsx scripts/scrape-yupmanga.ts --download --with-chapters",
    "mangas:scrape:mangadex": "npx tsx scripts/scrape-mangas-es.ts",
    "animeav1:catalog": "npx tsx scripts/scrape-animeav1.ts --catalog-only",
    "animeav1:download": "npx tsx scripts/scrape-animeav1.ts",
    "animeav1:airing": "npx tsx scripts/scrape-animeav1.ts --only-airing",
    "animeav1:fast": "npx tsx scripts/scrape-animeav1.ts --fast",
    "animeav1:full": "npx tsx scripts/scrape-animeav1.ts --fast --all-episodes",
    "animeav1:watch": "npx tsx scripts/scrape-animeav1.ts --watch --fast",
    "animeav1:watch:once": "npx tsx scripts/scrape-animeav1.ts --watch --fast --once",
    "mirror:catalog": "npx tsx scripts/mirror-catalog-to-drive.ts --catalog-only",
    "mirror:download": "npx tsx scripts/mirror-catalog-to-drive.ts",
    "mirror:drive-auth": "npx tsx scripts/drive-oauth-setup.ts",
    "mirror:register": "npx tsx scripts/register-drive-streams.ts",
    "db:setup": "prisma db push && node prisma/seed.cjs",
    "db:up": "docker compose up -d"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@mercadopago/sdk-js": "^0.0.3",
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "animeav1-api": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "hls.js": "^1.6.17",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
