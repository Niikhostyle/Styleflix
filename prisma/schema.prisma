generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  /// USER | SUPER_ADMIN
  role         String          @default("USER")

  /// NONE | PREPAID | PENDING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  /// PREPAID = cuenta revendedor lista; los días empiezan al primer login
  subscriptionStatus String    @default("NONE")
  currentPeriodEnd   DateTime?
  mpPreapprovalId    String?
  membershipStartedAt DateTime?
  cancelledAt        DateTime?
  /// DIRECT (MP $4990) | RESELLER ($2990, activación diferida)
  planSource         String    @default("DIRECT")
  /// Días a activar al primer uso (solo PREPAID / revendedor)
  prepaidDays        Int?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  watchHistory WatchProgress[]
  payments     Payment[]
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("MERCADOPAGO")
  externalId String?
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("CLP")
  status     String
  rawPayload Json?
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([externalId])
}

/// Progreso / historial de visionado (solo usuarios registrados)
model WatchProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType     String
  tmdbId        Int
  title         String
  posterPath    String?
  /// Temporada actual (series)
  season        Int?
  /// Episodio actual (series)
  episode       Int?
  /// 0–100 aproximado
  progressPct   Float    @default(5)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaType, tmdbId])
  @@index([userId, lastWatchedAt])
}

/// Config global (ej. minutos de preview sin membresía)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
