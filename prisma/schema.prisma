generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  /// null = pendiente de confirmar correo (registro público)
  emailVerified DateTime?
  /// USER | SUPER_ADMIN
  role         String          @default("USER")

  /// NONE | PREPAID | PENDING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  /// PREPAID = cuenta revendedor lista; los días empiezan al primer login
  subscriptionStatus String    @default("NONE")
  currentPeriodEnd   DateTime?
  mpPreapprovalId    String?
  membershipStartedAt DateTime?
  cancelledAt        DateTime?
  /// DIRECT (MP) | RESELLER (activación diferida)
  planSource         String    @default("DIRECT")
  /// Días a activar al primer uso (solo PREPAID / revendedor)
  prepaidDays        Int?

  /// standard | premium | plus
  planTier           String?
  /// monthly | semiannual | annual
  planPeriod         String?
  planMaxProfiles    Int?
  /// 720 | 1080
  planMaxResolution  Int?
  /// { canRequest, requestQuota, canDownload }
  planFeatures       Json?

  /// Fin de la demo de catálogo (30 min, una vez por cuenta)
  demoExpiresAt      DateTime?

  /// Última actividad en la plataforma (heartbeat / login)
  lastSeenAt         DateTime?
  lastIp             String?

  /// SUPER_ADMIN que creó / otorgó acceso (privacidad: grants del dueño ocultos al resto)
  grantedByUserId    String?
  grantedBy          User?     @relation("UserGrants", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedUsers       User[]    @relation("UserGrants")
  presenceSessions   PresenceSession[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  watchHistory WatchProgress[]
  mangaReads   MangaReadProgress[]
  payments     Payment[]
  authTokens   AuthToken[]
  profiles     Profile[]
  titleRequests TitleRequest[]
  feedbacks    Feedback[]

  @@index([grantedByUserId])
  @@index([lastSeenAt])
}

/// Perfiles de visionado (límite según plan)
model Profile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatarKey String   @default("1")
  isKids    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  playbackLock ProfilePlaybackLock?

  @@index([userId, sortOrder])
}

/// 1 reproducción simultánea por perfil (anti-abuso estricto)
model ProfilePlaybackLock {
  id            String   @id @default(cuid())
  profileId     String   @unique
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId        String
  /// UUID del dispositivo (localStorage)
  deviceId      String
  /// Token opaco que el cliente debe enviar en heartbeats / play
  lockToken     String
  titleLabel    String?
  ip            String?
  userAgent     String?
  acquiredAt    DateTime @default(now())
  lastHeartbeat DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([lastHeartbeat])
}

/// Tokens de verificación de email y restablecimiento de contraseña
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// EMAIL_VERIFY | PASSWORD_RESET
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("MERCADOPAGO")
  externalId String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("CLP")
  status     String
  rawPayload Json?
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([externalId])
}

/// Progreso / historial de visionado (solo usuarios registrados)
model WatchProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType     String
  tmdbId        Int
  title         String
  posterPath    String?
  /// Temporada actual (series)
  season        Int?
  /// Episodio actual (series)
  episode       Int?
  /// 0–100 aproximado
  progressPct   Float    @default(5)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaType, tmdbId])
  @@index([userId, lastWatchedAt])
}

/// Progreso de lectura de mangas (MangaDex)
model MangaReadProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId     String
  mangaSlug   String
  title       String
  poster      String?
  chapterId   String
  chapterNum  String
  pageIndex   Int      @default(0)
  progressPct Float    @default(0)
  lastReadAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, mangaId])
  @@index([userId, lastReadAt])
}

/// Config global (precios, catálogo de planes, etc.)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Links propios de reproducción por TMDB ID (prioridad sobre Vimeus/Pluto/etc.)
model StreamOverride {
  id        String   @id @default(cuid())
  /// movie | tv
  mediaType String
  tmdbId    Int
  /// null = título completo / todos los episodios
  season    Int?
  episode   Int?
  /// Nombre visible en admin (opcional)
  title     String?
  /// URL de embed o reproductor HTTPS
  embedUrl  String
  label     String   @default("VeoTV")
  enabled   Boolean  @default(true)
  /// Mayor = más prioridad si hay varios
  priority  Int      @default(10)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaType, tmdbId, enabled])
  @@index([tmdbId])
}

/// Solicitudes de títulos por usuarios con plan que lo permite
model TitleRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// movie | tv
  mediaType String
  tmdbId    Int
  title     String
  year      Int?
  note      String?
  /// PENDING | DONE | REJECTED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaType, tmdbId])
  @@index([status, createdAt])
}

/// Feedback público: dudas, quejas y sugerencias
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// DUDA | QUEJA | SUGERENCIA | OTRO
  category  String
  name      String
  email     String
  message   String
  /// NEW | READ | RESOLVED
  status    String   @default("NEW")
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([email, createdAt])
}

/// Eventos de seguridad (escaneo, scraping, auth, rate limit, etc.)
model SecurityEvent {
  id        String   @id @default(cuid())
  /// SCAN | SCRAPE | AUTH_FAIL | RATE_LIMIT | BLOCK | UNBLOCK | SUSPICIOUS | INFO
  type      String
  severity  String   @default("low") // low | medium | high | critical
  ip        String?
  path      String?
  method    String?
  userAgent String?
  userId    String?
  detail    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([severity, createdAt])
}

/// IPs bloqueadas manualmente o por auto-defensa
model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  /// MANUAL | AUTO_SCAN | AUTO_AUTH | AUTO_RATE
  source    String   @default("MANUAL")
  hits      Int      @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Sesiones / presencia en vivo (métricas de seguridad y actividad)
model PresenceSession {
  id         String   @id @default(cuid())
  /// Clave estable userId|ip|uaHash (o guest|ip)
  sessionKey String   @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String
  userAgent  String?
  path       String?
  country    String?
  hits       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
  @@index([ip, lastSeenAt])
}
